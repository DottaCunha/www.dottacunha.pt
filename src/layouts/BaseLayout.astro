---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import "../styles/global.css";
import type { Lang } from "../i18n/translations";
import { Font } from "astro:assets";
import { t } from "../i18n/utils";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  darkHeader?: boolean;
  /** Legal note shown in the footer of this page. */
  footerNote?: string;
  lang: Lang;
}

const {
  title,
  ogImage = "/logo_og.png",
  darkHeader = false,
  lang = "pt",
} = Astro.props;
const description = Astro.props.description || t("site.description", lang);
const { footerNote } = Astro.props;

const site = "https://dottacunha.pt";
const canonicalURL = new URL(Astro.url.pathname, site).href;
const ogImageURL = new URL(ogImage, site).href;
const fullTitle = `Dotta & Cunha | ${title}`;
---

<!doctype html>
<html lang={lang} data-theme="dottacunha">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* The colour of the browser's own bars on phones (the strip around the
        iPhone's island). Dark on pages that open with a photo; the header
        script turns it white once the page is scrolled. */}
    <meta name="theme-color" content={darkHeader ? "#0a0a0a" : "#ffffff"} />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={lang === "pt" ? "pt_PT" : "en_GB"} />
    <meta property="og:site_name" content="Dotta & Cunha" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Hreflang -->
    <link
      rel="alternate"
      hreflang="pt"
      href={`${site}/pt${Astro.url.pathname.replace(/^\/(en|pt)/, "")}`}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={`${site}/en${Astro.url.pathname.replace(/^\/(en|pt)/, "")}`}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={`${site}/pt${Astro.url.pathname.replace(/^\/(en|pt)/, "")}`}
    />

    <!-- Fonts -->
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-space-grotesk" preload />

    <!-- Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "Dotta & Cunha",
        legalName: "Dotta & Cunha, Lda",
        url: site,
        logo: `${site}/logo.svg`,
        description: t("site.description", lang),
        address: {
          "@type": "PostalAddress",
          addressLocality: lang === "pt" ? "Lisboa" : "Lisbon",
          addressCountry: "PT",
        },
        contactPoint: {
          "@type": "ContactPoint",
          email: "hello@dottacunha.pt",
          contactType: "customer service",
        },
      })}
    />
  </head>
  {/* Newer iPhones take the colour of that strip from the page background,
      so pages that open with a photo get a dark one. The content area keeps
      its own white background, so nothing else changes. */}
  <body
    class:list={["min-h-screen flex flex-col", darkHeader && "bg-primary"]}
  >
    <Header darkHeader={darkHeader} lang={lang} />
    <main class="flex-1 bg-base-100">
      <slot />
    </main>
    <Footer lang={lang} note={footerNote} />
    <CookieConsent lang={lang} />
    <script is:inline define:vars={{ lang }}>
      try {
        localStorage.setItem("dc-lang", lang);
      } catch (e) {}
    </script>
    <script>
      // Keep campaign parameters while the visitor moves around the site, so
      // a lead sent from another page still carries the ad it came from.
      // Done through the links themselves: nothing is stored on the device.
      const UTM_KEYS = [
        "utm_source",
        "utm_medium",
        "utm_campaign",
        "utm_content",
        "utm_term",
      ];
      const current = new URLSearchParams(window.location.search);
      const present = UTM_KEYS.filter((key) => current.get(key));

      if (present.length > 0) {
        document
          .querySelectorAll<HTMLAnchorElement>("a[href]")
          .forEach((link) => {
            const raw = link.getAttribute("href") ?? "";
            if (raw.startsWith("#")) return;
            const url = new URL(raw, window.location.href);
            if (url.origin !== window.location.origin) return;
            if (url.pathname.startsWith("/admin")) return;
            present.forEach((key) => {
              if (!url.searchParams.has(key)) {
                url.searchParams.set(key, current.get(key) as string);
              }
            });
            link.setAttribute("href", url.pathname + url.search + url.hash);
          });
      }
    </script>
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "6e0ff0618a5a4e23a4f578b3d1377f8f"}'></script>
  </body>
</html>
