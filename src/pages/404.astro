---
import "../styles/global.css";
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="pt" data-theme="dottacunha">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Página não encontrada | Dotta & Cunha</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-space-grotesk" preload />
  </head>
  <body
    class="min-h-screen flex items-center justify-center bg-primary text-primary-content"
  >
    <div class="text-center px-6">
      <span
        class="font-display text-[8rem] md:text-[12rem] font-extrabold leading-none tracking-tight opacity-20 block"
        >404</span
      >
      <h1
        class="font-display text-2xl md:text-4xl font-bold tracking-tight uppercase -mt-8 mb-4"
      >
        Página não encontrada
      </h1>
      <p class="text-body max-w-md mx-auto mb-3 opacity-80">
        A página que procura não existe ou foi movida.
      </p>
      <p class="text-body max-w-md mx-auto mb-10 opacity-60" lang="en">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/pt" class="btn btn-outline">Voltar ao Início</a>
        <a href="/en" class="btn btn-outline">Back to Home</a>
      </div>
    </div>
  </body>
</html>
