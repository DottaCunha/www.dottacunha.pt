---
import BrochureLabel from "../../../components/BrochureLabel.astro";
import { opticalStart } from "../../../lib/optical";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { t, localizedPath } from "../../../i18n/utils";
import type { Lang } from "../../../i18n/translations";
import { getCollection } from "astro:content";
import { getProjectSlug, getStatusLabel } from "../../../lib/projects";
import UnitCard from "../../../components/UnitCard.astro";
import SectionHeader from "../../../components/SectionHeader.astro";
import Icon from "../../../components/Icon.astro";
import HeroStats from "../../../components/HeroStats.astro";
import Carrascal168Cornice from "../../../components/projects/Carrascal168Cornice.astro";
import LocationMap from "../../../components/LocationMap.astro";
import ProjectInquiry from "../../../components/ProjectInquiry.astro";
import { supportedLangs } from "../../../i18n/translations";
import PublicPicture from "../../../components/PublicPicture.astro";

export async function getStaticPaths() {
  const allProjects = await getCollection("projects");
  const paths = [];

  for (const lang of supportedLangs) {
    const langProjects = allProjects.filter(
      (p) => p.id.startsWith(`${lang}/`) && p.data.visible !== false,
    );
    for (const project of langProjects) {
      const slug = getProjectSlug(project.id);
      paths.push({
        params: { lang, slug },
        props: { project },
      });
    }
  }

  return paths;
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const isCarrascal = slug === "carrascal-168";
const { project } = Astro.props;
const d = project.data;
const statusLabel = getStatusLabel(d.status, t, lang);
const units = d.units ?? [];
const sections = d.sections ?? [];
const typeLabel = t(`projectType.${d.type}`, lang);
// "Carrascal 168, Beato, Lisboa" (the layout puts the brand in front).
const pageTitle = `${d.title}, ${d.location}`;

// Structured data for search engines (not shown on the page).
const place = (d.sections ?? []).find((section) => section.map)?.map;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ApartmentComplex",
  name: d.title,
  description: d.seoDescription ?? d.description,
  url: new URL(Astro.url.pathname, "https://dottacunha.pt").href,
  image: new URL(d.image, "https://dottacunha.pt").href,
  numberOfAccommodationUnits: d.totalUnits,
  address: {
    "@type": "PostalAddress",
    streetAddress: d.streetAddress,
    postalCode: d.postalCode,
    addressLocality: d.location,
    addressCountry: "PT",
  },
  ...(place && {
    geo: {
      "@type": "GeoCoordinates",
      latitude: place.lat,
      longitude: place.lng,
    },
  }),
};
const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      name: t("nav.projects", lang),
      item: new URL(localizedPath("/projects", lang), "https://dottacunha.pt")
        .href,
    },
    { name: d.title, item: structuredData.url },
  ].map((crumb, i) => ({ "@type": "ListItem", position: i + 1, ...crumb })),
};
const facts = [
  {
    icon: "units",
    label: t("projectDetail.totalUnits", lang),
    value: String(d.totalUnits),
  },
  d.typologies
    ? {
        icon: "bed",
        label: t("projectDetail.typologies", lang),
        value: d.typologies,
      }
    : {
        icon: "area",
        label: t("projectDetail.area", lang),
        value: `${d.area} m²`,
      },
  d.completion
    ? {
        icon: "calendar",
        label: t("projectDetail.completion", lang),
        value: d.completion,
      }
    : {
        icon: "calendar",
        label: t("projectsPage.year", lang),
        value: String(d.year),
      },
] as const;
---

<BaseLayout
  title={pageTitle}
  description={d.seoDescription ?? d.description}
  ogImage={d.image}
  darkHeader={true}
  footerNote={t("projectDetail.disclaimer", lang)}
  lang={lang}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
  <!-- Header: the building as background, text on the left, facts on the right -->
  <section
    class="hero-detail hero-behind-bar relative flex items-end bg-neutral text-primary-content overflow-hidden"
  >
    {/* Below 1024px the text sits on top of the whole photo, so the photo is
        darkened more there than on desktop, where the text has its own side. */}
    <div class="absolute inset-0">
      <PublicPicture
        priority
        src={d.image}
        alt={d.title}
        formats={["avif", "webp"]}
        widths={[400, 800, 1200, 1600, 2000]}
        sizes="100vw"
        pictureAttributes={{ class: "block w-full h-full" }}
        class="w-full h-full object-cover"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t lg:bg-gradient-to-r from-primary/90 via-primary/75 to-primary/50 lg:from-primary/85 lg:via-primary/55 lg:to-primary/10"
      >
      </div>
      <div
        class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-primary/70 to-transparent hidden lg:block"
      >
      </div>
    </div>

    {/* On phones the photo runs past the bottom of the screen, behind the
        browser's address bar, while the text stops above the bar (see the
        hero classes in global.css). On tablets this header keeps more room
        under the figures than the unit header, which has the highlights
        there. */}
    <div
      class="container relative z-10 hero-detail-pad hero-detail-above-bar md:max-lg:pb-24"
    >
      <a
        href={localizedPath("/projects", lang)}
        class="hero-detail-back text-meta text-primary-content/70 hover:text-primary-content"
      >
        <svg
          class="w-3.5 h-3.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M7 16l-4-4m0 0l4-4m-4 4h18"></path></svg
        >
        {t("projectDetail.back", lang)}
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-10 lg:gap-16 items-end">
        <div class="lg:col-span-7">
          <span class="badge bg-base-100 text-base-content flex w-fit mb-4 sm:mb-6">
            {statusLabel}
          </span>
          {/* Carrascal 168 carries its own identity from the brochure: the
              cornice mark above the eyebrow (as on the unit pages) and the
              number in the facade's blue. On short phone screens the mark is
              left out, so the header still fits the first screen. */}
          {
            isCarrascal && (
              <Carrascal168Cornice
                tone="onPhoto"
                class="w-[4.5rem] mb-3.5 max-md:[@media(max-height:640px)]:hidden"
              />
            )
          }
          <span
            class="section-label-sm text-primary-content/70 mb-4"
            style={opticalStart(typeLabel, "sans")}
          >
            {`${typeLabel} · ${d.location}`}
          </span>
          <h1
            class="heading-hero hero-detail-title"
            style={opticalStart(d.title, "display")}
          >
            {
              isCarrascal ? (
                <>
                  {d.title.replace(/\s*168$/, "")}{" "}
                  <span class="text-[#acceda]">168</span>
                </>
              ) : (
                d.title
              )
            }
          </h1>
          <p class="text-body text-pretty text-primary-content/90">
            {d.description}
          </p>
        </div>

        {/* On phones the two buttons share a row, so the whole header fits
            on the first screen. The main button always gets room for its
            label on one line; the brochure button takes what is left, and
            shortens its own label when that is too little (BrochureLabel).
            Below 360px not even that fits, so there the buttons use the
            next text size down and less padding. */}
        <div class="lg:col-span-5 grid grid-cols-[minmax(max-content,1fr)_auto] max-[360px]:grid-cols-[1fr_min-content] sm:flex sm:flex-col gap-3">
          <a
            href="#contacto"
            class="btn btn-lg btn-inverted w-full text-mid min-[360px]:max-sm:px-3 max-[360px]:px-2 max-[360px]:text-xs"
          >
            {t("projectDetail.inquire", lang)}
          </a>
          {
            d.brochure && (
              <a
                href={d.brochure}
                target="_blank"
                rel="noopener"
                aria-label={t("projectDetail.brochure", lang)}
                class="btn btn-lg btn-outline btn-light w-full text-mid min-[360px]:max-sm:px-3 max-[360px]:px-2 max-[360px]:text-xs bg-primary/30 hover:bg-base-100"
              >
                <BrochureLabel lang={lang} />
              </a>
            )
          }
        </div>
      </div>

      {/* Same 12 columns as the row above: the last figure starts where
          the button starts. */}
      <HeroStats
        tone="onPhoto"
        class="sm:grid-cols-3 lg:grid-cols-12 gap-4 sm:gap-6 lg:gap-16"
        facts={facts.map((fact, i) => ({
          ...fact,
          class: ["lg:col-span-4", "lg:col-span-3", "lg:col-span-5"][i],
        }))}
      />
    </div>
  </section>

  <!-- Units -->
  <section id="unidades" class="section bg-base-200 scroll-mt-20">
    <div class="container">
      <SectionHeader
        label={d.unitsLabel}
        heading={t("projectDetail.units", lang)}
      />
      {
        units.length > 0 ? (
          <div class="border-t border-base-300 lg:border-0 lg:grid lg:grid-cols-3 lg:gap-x-8 lg:gap-y-14">
            {units.map((unit) => (
              <UnitCard
                lang={lang}
                slug={slug}
                projectTitle={d.title}
                unit={unit}
              />
            ))}
          </div>
        ) : (
          <p class="text-body">{t("projectDetail.noUnits", lang)}</p>
        )
      }
    </div>
  </section>

  <!-- Sections: finishes (photo tiles + list), location (map + list), ... -->
  {
    sections.map((section, i) => {
      const items = section.items ?? [];
      const tiles = items.filter((item) => item.image);
      const rows = items.filter((item) => !item.image);
      const list = section.list ?? [];
      return (
        <section
          id={section.key}
          class:list={[
            "section scroll-mt-20",
            i % 2 === 0 ? "bg-base-100" : "bg-base-200",
          ]}
        >
          <div class="container">
            <SectionHeader
              label={section.label}
              heading={section.heading}
              body={section.body}
            />

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 xl:gap-16 items-start">
              {tiles.length > 0 && (
                <div
                  class:list={[
                    list.length > 0
                      ? "lg:col-span-8 lg:order-2"
                      : "lg:col-span-12",
                  ]}
                >
                  {section.itemsHeading && (
                    <h3 class="text-meta text-base-content pb-4 mb-6 border-b border-base-content">
                      {section.itemsHeading}
                    </h3>
                  )}
                  <div class="grid grid-cols-2 md:grid-cols-3 gap-x-4 md:gap-x-6 gap-y-10 md:gap-y-12">
                  {tiles.map((item) => (
                    <figure>
                      <div class="aspect-[4/3] overflow-hidden bg-base-300">
                        <PublicPicture
                          src={item.image!}
                          alt={`${item.label}: ${item.body ?? ""}`}
                          formats={["avif", "webp"]}
                          widths={[400, 800]}
                          sizes="(max-width: 768px) 50vw, 300px"
                          loading="lazy"
                          pictureAttributes={{ class: "block w-full h-full" }}
                          class="w-full h-full object-cover"
                        />
                      </div>
                      <figcaption class="mt-4">
                        <span class="text-meta text-base-content block">
                          {item.label}
                        </span>
                        {item.body && (
                          <span class="text-body-sm text-dark-600 block mt-1.5">
                            {item.body}
                          </span>
                        )}
                      </figcaption>
                    </figure>
                  ))}
                  </div>
                </div>
              )}

              {list.length > 0 && (
                <div
                  class:list={[
                    tiles.length > 0
                      ? "lg:col-span-4 lg:order-1"
                      : "lg:col-span-12",
                  ]}
                >
                  {section.listHeading && (
                    <h3 class="text-meta text-base-content pb-4 border-b border-base-content">
                      {section.listHeading}
                    </h3>
                  )}
                  <ul>
                    {list.map((entry) => (
                      <li class="text-body-sm text-dark-600 py-3.5 border-b border-base-300">
                        {entry}
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {section.image && (
                <div
                  class:list={[
                    // The map is as tall as the list beside it, and gives
                    // the list half the width so its rows are not squeezed.
                    section.map
                      ? "lg:col-span-6 xl:col-span-7 lg:self-stretch"
                      : "lg:col-span-7",
                  ]}
                >
                  {section.map ? (
                    <LocationMap
                      lang={lang}
                      image={section.image}
                      alt={`${section.heading}, ${d.title}`}
                      title={d.title}
                      map={section.map}
                      points={items.flatMap((item) =>
                        (item.index || item.icon) && item.lat && item.lng
                          ? [
                              {
                                id: (item.index ?? item.icon)!,
                                index: item.index,
                                icon: item.icon,
                                label: item.label,
                                lat: item.lat,
                                lng: item.lng,
                              },
                            ]
                          : [],
                      )}
                    />
                  ) : (
                    <PublicPicture
                      src={section.image}
                      alt={`${section.heading}, ${d.title}`}
                      formats={["avif", "webp"]}
                      widths={[400, 800, 1200, 1600]}
                      sizes="(max-width: 1024px) 100vw, 58vw"
                      loading="lazy"
                      class="w-full h-auto"
                    />
                  )}
                </div>
              )}

              {rows.length > 0 && (
                <div
                  class:list={[
                    section.map
                      ? "lg:col-span-6 xl:col-span-5"
                      : section.image
                        ? "lg:col-span-5"
                        : "lg:col-span-12",
                  ]}
                >
                  {/* The table can carry a heading of its own (here, the
                      address), like the lists in the other sections. */}
                  {section.itemsHeading && (
                    <h3 class="text-meta text-base-content pb-4 border-b border-base-content">
                      {section.itemsHeading}
                    </h3>
                  )}
                <dl
                  class:list={[
                    !section.itemsHeading && "border-t border-base-300",
                  ]}
                >
                  {rows.map((item) => (
                    <div
                      class="flex items-center gap-3 py-2.5 border-b border-base-300 transition-colors"
                      data-point={
                        item.lat && item.lng
                          ? (item.index ?? item.icon)
                          : undefined
                      }
                    >
                      {(item.icon || item.index) && (
                        <span class="w-6 shrink-0 flex justify-center">
                          {item.icon ? (
                            <Icon name={item.icon} class="w-5 h-5" />
                          ) : (
                            <span class="w-5 h-5 rounded-full bg-base-content text-base-100 text-2xs font-semibold tabular-nums flex items-center justify-center">
                              {item.index}
                            </span>
                          )}
                        </span>
                      )}
                      <dt class="text-body-sm font-medium text-base-content flex-1 min-w-0">
                        {item.label}
                      </dt>
                      <dd class="flex items-center justify-end gap-2 text-body-sm text-dark-600 whitespace-nowrap">
                        {(item.times ?? []).map((time) => (
                          <span class="inline-flex items-center justify-end gap-1.5 w-[4.5rem] tabular-nums">
                            {time.value}
                            <span class="sr-only">
                              {t(`travel.${time.mode}`, lang)}
                            </span>
                            <Icon
                              name={time.mode}
                              class="w-4 h-4 shrink-0"
                            />
                          </span>
                        ))}
                        {item.distance && (
                          <span class="hidden sm:inline-block w-14 text-right tabular-nums">
                            {item.distance}
                          </span>
                        )}
                        {item.body}
                      </dd>
                    </div>
                  ))}
                </dl>
                </div>
              )}
            </div>
          </div>
        </section>
      );
    })
  }

  <ProjectInquiry
    lang={lang}
    project={d.title}
    units={units}
    background={sections.length % 2 === 0 ? "bg-base-100" : "bg-base-200"}
  />
</BaseLayout>
