---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { t, localizedPath } from "../../../../i18n/utils";
import type { Lang } from "../../../../i18n/translations";
import { getCollection } from "astro:content";
import {
  getProjectSlug,
  unitLabel,
  formatArea,
} from "../../../../lib/projects";
import { supportedLangs } from "../../../../i18n/translations";
import PublicPicture from "../../../../components/PublicPicture.astro";
import PhotoStrip from "../../../../components/PhotoStrip.astro";
import UnitCard from "../../../../components/UnitCard.astro";
import SectionHeader from "../../../../components/SectionHeader.astro";
import ProjectInquiry from "../../../../components/ProjectInquiry.astro";

export async function getStaticPaths() {
  const allProjects = await getCollection("projects");
  const paths = [];

  for (const lang of supportedLangs) {
    const langProjects = allProjects.filter(
      (p) => p.id.startsWith(`${lang}/`) && p.data.visible !== false,
    );
    for (const project of langProjects) {
      const slug = getProjectSlug(project.id);
      const units = project.data.units ?? [];
      for (const unit of units) {
        paths.push({
          params: { lang, slug, unitId: unit.id },
          props: { project, unit },
        });
      }
    }
  }

  return paths;
}

const { lang, slug, unitId } = Astro.params as {
  lang: Lang;
  slug: string;
  unitId: string;
};
const { project, unit } = Astro.props;
const d = project.data;
const units = d.units ?? [];
const otherUnits = units.filter((other) => other.id !== unit.id);
const photos = unit.photos ?? [];
const features = unit.features ?? [];
const label = unitLabel(unit);
const area = `${formatArea(unit.area, lang)} m²`;
const floor = unit.floorLabel ?? String(unit.floor);
const projectUrl = localizedPath(`/projects/${slug}`, lang);

// Rooms are numbered across all the plans of the unit, like on the drawings
// (the upper floor of the duplex continues from 9).
let roomNumber = 0;
const plans = (unit.plans ?? []).map((plan) => ({
  ...plan,
  rooms: (plan.rooms ?? []).map((room) => ({ ...room, number: ++roomNumber })),
}));

// "T2, 74,23 m², Piso 1. Duas varandas. Carrascal 168, Beato, Lisboa."
const pageDescription = [
  [unit.typology, area, floor].join(", "),
  unit.highlight,
  `${d.title}, ${d.location}`,
]
  .filter(Boolean)
  .join(". ")
  .concat(".");

const facts = [
  { label: t("unitDetail.grossAreaShort", lang), value: area },
  { label: t("unitDetail.floor", lang), value: floor },
  { label: t("unitDetail.bedrooms", lang), value: String(unit.bedrooms) },
  { label: t("unitDetail.bathrooms", lang), value: String(unit.bathrooms) },
  ...(unit.energyRating
    ? [{ label: t("unitDetail.energy", lang), value: unit.energyRating }]
    : []),
];
---

<BaseLayout
  title={`${label}, ${d.title}, ${d.location}`}
  description={pageDescription}
  ogImage={photos[0] ?? d.image}
  footerNote={t("projectDetail.disclaimer", lang)}
  lang={lang}
>
  <!-- Header -->
  <section class="pt-32 pb-12 md:pb-16 bg-base-100">
    <div class="container">
      <a
        href={projectUrl}
        class="inline-flex items-center gap-2 text-link text-info hover:text-base-content mb-10"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M7 16l-4-4m0 0l4-4m-4 4h18"></path></svg
        >
        {d.title}
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-20 items-end">
        <div class="lg:col-span-6">
          {
            unit.letter && (
              <span class="section-label mb-4">
                {`${t("unitDetail.apartment", lang)} ${unit.letter}`}
              </span>
            )
          }
          <h1
            class="font-display text-5xl md:text-7xl font-extrabold text-primary tracking-tight uppercase leading-[0.95] mb-5"
          >
            {unit.typology}
          </h1>
          <p class="text-body">{`${d.title}, ${d.location}`}</p>
          {
            unit.description && (
              <p class="text-body text-prose mt-6">{unit.description}</p>
            )
          }
          {
            features.length > 0 && (
              <ul class="mt-8 space-y-2">
                {features.map((feature) => (
                  <li class="flex items-center gap-3 text-body-sm text-dark-600">
                    <span class="w-1.5 h-1.5 bg-neutral shrink-0" />
                    {feature}
                  </li>
                ))}
              </ul>
            )
          }
          <a href="#contacto" class="btn btn-primary mt-10">
            {t("unitDetail.inquire", lang)}
          </a>
        </div>

        <div class="lg:col-span-6">
          <dl
            class="grid grid-cols-2 sm:grid-cols-3 gap-x-8 gap-y-8 border-t border-base-300 pt-8"
          >
            {
              facts.map((fact) => (
                <div>
                  <dd class="text-stat text-2xl md:text-3xl">{fact.value}</dd>
                  <dt class="text-meta mt-1">{fact.label}</dt>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- Photos -->
  {
    photos.length > 0 && (
      <section class="pb-24 md:pb-32 bg-base-100">
        <div class="container">
          <PhotoStrip
            lang={lang}
            photos={photos}
            alt={`${label}, ${d.title}`}
          />
        </div>
      </section>
    )
  }

  <!-- Floor plans and areas -->
  {
    plans.length > 0 && (
      <section id="planta" class="section bg-base-200 scroll-mt-20">
        <div class="container">
          <SectionHeader
            heading={t("unitDetail.plansHeading", lang)}
            body={unit.areaNote}
          />

          <div class="space-y-16">
            {plans.map((plan) => (
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
                <a
                  href={plan.image}
                  target="_blank"
                  rel="noopener"
                  class="lg:col-span-7 block bg-white p-4 md:p-8"
                >
                  <PublicPicture
                    src={plan.image}
                    alt={[t("unitDetail.floorPlan", lang), label, plan.label]
                      .filter(Boolean)
                      .join(", ")}
                    formats={["avif", "webp"]}
                    widths={[400, 800, 1200, 1600]}
                    sizes="(max-width: 1024px) 100vw, 58vw"
                    loading="lazy"
                    class="w-full h-auto"
                  />
                </a>
                <div class="lg:col-span-5">
                  {plan.label && (
                    <h3 class="heading-card-sm mb-4">{plan.label}</h3>
                  )}
                  <dl class="border-t border-base-300">
                    {plan.rooms.map((room) => (
                      <div class="flex items-baseline gap-4 py-3 border-b border-base-300">
                        <span class="text-xs font-semibold tabular-nums w-5 shrink-0">
                          {room.number}
                        </span>
                        <dt class="text-body-sm flex-1">{room.label}</dt>
                        <dd class="text-body-sm tabular-nums whitespace-nowrap">
                          {`${formatArea(room.area, lang)} m²`}
                        </dd>
                      </div>
                    ))}
                  </dl>
                </div>
              </div>
            ))}
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mt-10">
            <div class="lg:col-start-8 lg:col-span-5">
              <div class="flex items-baseline justify-between gap-4 border-t border-base-content pt-4">
                <span class="text-body font-semibold">
                  {t("unitDetail.grossArea", lang)}
                </span>
                <span class="text-stat text-xl whitespace-nowrap">{area}</span>
              </div>
              <p class="text-footnote mt-4">
                {t("unitDetail.areasNote", lang)}
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Other units -->
  {
    otherUnits.length > 0 && (
      <section class="section bg-base-100">
        <div class="container">
          <div class="flex flex-wrap items-end justify-between gap-6 mb-12">
            <h2 class="section-heading">{t("unitDetail.others", lang)}</h2>
            <a href={`${projectUrl}#acabamentos`} class="btn btn-outline">
              {t("unitDetail.projectLink", lang)}
            </a>
          </div>
          <div class="border-t border-base-300 lg:border-0 lg:grid lg:grid-cols-3 lg:gap-x-8 lg:gap-y-14">
            {otherUnits.map((other) => (
              <UnitCard
                lang={lang}
                slug={slug}
                projectTitle={d.title}
                unit={other}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <ProjectInquiry
    lang={lang}
    project={d.title}
    units={units}
    selected={unitId}
    background={otherUnits.length > 0 ? "bg-base-200" : "bg-base-100"}
  />
</BaseLayout>
