---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { t, localizedPath } from "../../../../i18n/utils";
import type { Lang } from "../../../../i18n/translations";
import { getCollection } from "astro:content";
import {
  getProjectSlug,
  unitLabel,
  formatArea,
} from "../../../../lib/projects";
import { supportedLangs } from "../../../../i18n/translations";
import PublicPicture from "../../../../components/PublicPicture.astro";
import PhotoStrip from "../../../../components/PhotoStrip.astro";
import UnitCard from "../../../../components/UnitCard.astro";
import SectionHeader from "../../../../components/SectionHeader.astro";
import ProjectInquiry from "../../../../components/ProjectInquiry.astro";
import Lightbox from "../../../../components/Lightbox.astro";
import UnitPlans from "../../../../components/UnitPlans.astro";
import Icon from "../../../../components/Icon.astro";

export async function getStaticPaths() {
  const allProjects = await getCollection("projects");
  const paths = [];

  for (const lang of supportedLangs) {
    const langProjects = allProjects.filter(
      (p) => p.id.startsWith(`${lang}/`) && p.data.visible !== false,
    );
    for (const project of langProjects) {
      const slug = getProjectSlug(project.id);
      const units = project.data.units ?? [];
      for (const unit of units) {
        paths.push({
          params: { lang, slug, unitId: unit.id },
          props: { project, unit },
        });
      }
    }
  }

  return paths;
}

const { lang, slug, unitId } = Astro.params as {
  lang: Lang;
  slug: string;
  unitId: string;
};
const { project, unit } = Astro.props;
const d = project.data;
const units = d.units ?? [];
const otherUnits = units.filter((other) => other.id !== unit.id);
const photos = unit.photos ?? [];
const features = unit.features ?? [];
const finishes = unit.finishes ?? [];
const label = unitLabel(unit);
const area = `${formatArea(unit.area, lang)} m²`;
const floor = unit.floorLabel ?? String(unit.floor);
const projectUrl = localizedPath(`/projects/${slug}`, lang);
const unitName = unit.letter
  ? `${t("unitDetail.apartment", lang)} ${unit.letter}`
  : unit.typology;
// "Pisos 2 e 3" under the label "Piso" says it twice: keep the numbers.
const floorValue = floor.replace(/^\D+(?=\d)/, "");

// Rooms are numbered across all the plans of the unit, like on the drawings
// (the upper floor of the duplex continues from 9).
let roomNumber = 0;
const plans = (unit.plans ?? []).map((plan) => ({
  ...plan,
  rooms: (plan.rooms ?? []).map((room) => ({ ...room, number: ++roomNumber })),
}));

// The unit's own sentence, then where it is: "T2 no piso 1. A sala e a
// cozinha… 74,23 m², Carrascal 168, Beato, Lisboa."
const pageDescription = [
  unit.description,
  `${area}, ${d.title}, ${d.location}.`,
]
  .filter(Boolean)
  .join(" ");
const pageUrl = new URL(Astro.url.pathname, "https://dottacunha.pt").href;
const absolute = (path: string) => new URL(path, "https://dottacunha.pt").href;

// Structured data for search engines (not shown on the page): the home
// itself, and where the page sits in the site.
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Apartment",
    name: `${unitName}, ${d.title}`,
    description: unit.description,
    url: pageUrl,
    image: photos.map(absolute),
    floorSize: {
      "@type": "QuantitativeValue",
      value: unit.area,
      unitCode: "MTK",
    },
    numberOfBedrooms: unit.bedrooms,
    numberOfBathroomsTotal: unit.bathrooms,
    floorLevel: floor,
    address: {
      "@type": "PostalAddress",
      streetAddress: d.streetAddress,
      postalCode: d.postalCode,
      addressLocality: d.location,
      addressCountry: "PT",
    },
    containedInPlace: {
      "@type": "ApartmentComplex",
      name: d.title,
      url: absolute(projectUrl),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        name: t("nav.projects", lang),
        item: absolute(localizedPath("/projects", lang)),
      },
      { name: d.title, item: absolute(projectUrl) },
      { name: unitName, item: pageUrl },
    ].map((crumb, i) => ({ "@type": "ListItem", position: i + 1, ...crumb })),
  },
];

const facts = [
  { icon: "area", label: t("unitDetail.grossAreaShort", lang), value: area },
  { icon: "floor", label: t("unitDetail.floor", lang), value: floorValue },
  {
    icon: "bed",
    label: t("unitDetail.bedrooms", lang),
    value: String(unit.bedrooms),
  },
  {
    icon: "bath",
    label: t("unitDetail.bathrooms", lang),
    value: String(unit.bathrooms),
  },
] as const;
---

<BaseLayout
  title={`${d.title}, ${d.location} - ${unit.seoTitle ?? unit.typology}`}
  description={pageDescription}
  ogImage={photos[0] ?? d.image}
  footerNote={t("projectDetail.disclaimer", lang)}
  lang={lang}
>
  {
    structuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))
  }
  <!-- Header: text and buttons, the facts, then the photos. On phones the
       photos come right after the text. -->
  <section
    class="pt-32 md:pt-36 pb-14 md:pb-16 bg-base-100 md:flex md:items-end md:min-h-[max(70vh,57rem)] lg:min-h-[max(70vh,43.75rem)]"
  >
    <div class="container w-full">
      <a
        href={projectUrl}
        class="inline-flex items-center gap-2 text-meta hover:text-base-content transition-colors py-2 -mt-2 mb-8"
      >
        <svg
          class="w-3.5 h-3.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M7 16l-4-4m0 0l4-4m-4 4h18"></path></svg
        >
        {`${d.title}, ${d.location}`}
      </a>

      {/* Below 1024px everything stacks, and the facts come before the
          highlights: text, facts, highlights. */}
      <div class="flex flex-col lg:block">
      <div class="contents lg:grid lg:grid-cols-12 lg:gap-x-16">
        <div class="order-1 lg:col-span-8">
          <span class="section-label text-xxs md:text-sm leading-none text-secondary mb-4">
            {unitName}
          </span>
          <h1
            class="heading-hero text-base-content text-5xl md:text-6xl xl:text-7xl mb-5"
          >
            {unit.typology}
          </h1>
          {
            unit.description && (
              <p class="text-body text-pretty max-w-2xl">{unit.description}</p>
            )
          }
          {
            unit.energyRating && (
              <p class="flex items-center gap-2.5 mt-5">
                {/* The arrow-shaped tag used for the rating in the brochure,
                    at the size of the status chip on the project page. */}
                <svg viewBox="0 0 50 30" class="h-6 w-auto" aria-hidden="true">
                  <path
                    d="M1 1h33l15 14-15 14H1z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linejoin="round"
                  />
                  <text
                    x="19"
                    y="21.5"
                    text-anchor="middle"
                    font-size="18"
                    class="font-display font-bold"
                    fill="currentColor"
                  >
                    {unit.energyRating}
                  </text>
                </svg>
                <span class="sr-only">{unit.energyRating}</span>
                <span class="text-meta">{t("unitDetail.energy", lang)}</span>
              </p>
            )
          }
          <div class="flex flex-col sm:flex-row gap-3 mt-8">
            <a href="#contacto" class="btn btn-lg btn-primary text-mid">
              {t("unitDetail.inquire", lang)}
            </a>
            {
              d.brochure && (
                <a
                  href={d.brochure}
                  target="_blank"
                  rel="noopener"
                  class="btn btn-lg btn-outline text-mid"
                >
                  {t("projectDetail.brochure", lang)}
                </a>
              )
            }
          </div>
        </div>

        {
          features.length > 0 && (
            <div class="order-3 mt-10 lg:mt-0 lg:col-span-4 lg:col-start-9 lg:self-end">
              <h2 class="text-meta text-base-content pb-4 border-b border-base-content">
                {t("unitDetail.features", lang)}
              </h2>
              <ul>
                {features.map((feature) => (
                  <li class="text-body py-3 border-b border-base-300">
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      <!-- After the title block: the facts in a row. -->
      <dl
        class="order-2 grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-8 border-t border-base-300 mt-10 md:mt-12 pt-6"
      >
        {
          facts.map((fact) => (
            // The label comes first for screen readers; on screen the
            // value stays on top.
            <div class="flex flex-col-reverse">
              <dt class="text-meta flex items-center gap-2 mt-2 whitespace-nowrap">
                <Icon name={fact.icon} class="w-4 h-4 shrink-0" />
                {fact.label}
              </dt>
              <dd class="text-stat text-2xl md:text-3xl whitespace-nowrap">
                {fact.value}
              </dd>
            </div>
          ))
        }
      </dl>
      </div>
    </div>
  </section>

  <!-- Photos, on the grey band between the header and the plans -->
  {
    photos.length > 0 && (
      <section class="py-16 md:py-24 bg-base-200">
        <div class="container">
          <PhotoStrip
            lang={lang}
            photos={photos}
            alt={`${unitName}, ${d.title}`}
            captions={unit.photoCaptions}
          />
        </div>
      </section>
    )
  }

  <!-- Floor plans and areas -->
  {
    plans.length > 0 && (
      <section id="planta" class="section bg-base-100 scroll-mt-20">
        <div class="container">
          <SectionHeader
            label={floor}
            heading={t("unitDetail.plansHeading", lang)}
          />

          <UnitPlans
            lang={lang}
            label={label}
            plans={plans}
            area={area}
            note={unit.areaNote}
          />
        </div>
      </section>
    )
  }

  <!-- Finishes that change from unit to unit: kitchen and bathrooms -->
  {
    finishes.length > 0 && (
      <section id="acabamentos" class="section bg-base-200 scroll-mt-20">
        <div class="container">
          <SectionHeader
            label={unit.letter
              ? `${t("unitDetail.apartment", lang)} ${unit.letter}`
              : undefined}
            heading={t("unitDetail.finishes", lang)}
          />
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
            <div class="lg:col-span-8 lg:order-2 grid grid-cols-2 gap-x-4 md:gap-x-6 gap-y-10">
              {finishes.map((item) => (
                <figure>
                  <div class="aspect-[4/3] overflow-hidden bg-base-300">
                    <PublicPicture
                      src={item.image}
                      alt={`${item.label}: ${item.body ?? ""}`}
                      formats={["avif", "webp"]}
                      widths={[400, 800]}
                      sizes="(max-width: 1024px) 50vw, 400px"
                      loading="lazy"
                      pictureAttributes={{ class: "block w-full h-full" }}
                      class="w-full h-full object-cover"
                    />
                  </div>
                  <figcaption class="mt-4">
                    <span class="text-meta text-base-content block">
                      {item.label}
                    </span>
                    {item.body && (
                      <span class="text-body-sm text-dark-600 block mt-1.5">
                        {item.body}
                      </span>
                    )}
                  </figcaption>
                </figure>
              ))}
            </div>
            <div class="lg:col-span-4 lg:order-1">
              <p class="text-body-sm text-dark-600">
                {t("unitDetail.finishesBody", lang)}
              </p>
              <a
                href={`${projectUrl}#acabamentos`}
                class="inline-flex items-center gap-2 text-link text-base-content hover:text-dark-600 py-2 mt-4 -mb-2"
              >
                {t("unitDetail.finishesLink", lang)}
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"
                  />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Other units -->
  {
    otherUnits.length > 0 && (
      <section class={`py-16 md:py-24 ${finishes.length > 0 ? "bg-base-100" : "bg-base-200"}`}>
        <div class="container">
          <div class="flex flex-wrap items-end justify-between gap-6 mb-8">
            <h2 class="heading-card">{t("unitDetail.others", lang)}</h2>
            <a
              href={`${projectUrl}#localizacao`}
              class="text-link text-secondary hover:text-base-content inline-block py-2 -my-2"
            >
              {t("unitDetail.projectLink", lang)}
            </a>
          </div>
          <div class="border-t border-base-300 md:grid md:grid-cols-2 md:gap-x-16">
            {otherUnits.map((other) => (
              <UnitCard
                compact
                lang={lang}
                slug={slug}
                projectTitle={d.title}
                unit={other}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <ProjectInquiry
    lang={lang}
    project={d.title}
    units={units}
    selected={unitId}
    background={
      (otherUnits.length > 0) !== (finishes.length > 0)
        ? "bg-base-100"
        : "bg-base-200"
    }
  />

  <Lightbox lang={lang} />
</BaseLayout>
