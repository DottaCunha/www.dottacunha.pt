---
import Hero from "../../components/blocks/Hero.astro";
import ContactDetails from "../../components/ContactDetails.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import NetlifyForm from "../../components/NetlifyForm.astro";
import type { Lang } from "../../i18n/translations";
import { getI18nPaths, t } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params as { lang: Lang };
const successMsg =
  lang === "pt"
    ? "Obrigado! Entraremos em contacto em breve."
    : "Thank you! We'll be in touch soon.";
---

<BaseLayout title={t("nav.contact", lang)} lang={lang} darkHeader>
  <Hero
    variant="half"
    label={t("contactPage.label", lang)}
    heading={t("contactPage.heading", lang)}
    image={"/images/architecture-05.jpg"}
  />

  {/* Laid out like the contact section of the project and unit pages:
      the introduction and the direct contacts on the left, the form on the
      right. On phones and tablets they stack as introduction, form,
      contacts. */}
  {/* The anchor the header's button leads to. As on the project pages, the
      section's own top padding clears the fixed header. */}
  <section id="contacto" class="section bg-base-100 scroll-mt-4 md:scroll-mt-0">
    <div class="container">
      <div
        class="grid grid-cols-1 lg:grid-cols-12 lg:grid-rows-[auto_1fr] gap-12 lg:gap-x-20 lg:gap-y-10"
      >
        <div class="lg:col-span-5">
          <SectionHeader
            label={t("inquiry.label", lang)}
            heading={t("inquiry.heading", lang)}
            body={t("inquiry.body", lang)}
            spacing=""
          />
        </div>

        <div class="lg:col-span-7 lg:row-span-2">
        <NetlifyForm
          name="contact"
          class="space-y-5"
          successMessage={successMsg}
        >
          {/* Same fields in the same order as the form on the project
              pages: name and email, then phone and one choice, then the
              message. */}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label for="name" class="label">
                <span class="label-text">{t("inquiry.name", lang)}</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                class="input w-full"
              />
            </div>
            <div>
              <label for="email" class="label">
                <span class="label-text">{t("contactPage.email", lang)}</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="input w-full"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label for="phone" class="label">
              <span class="label-text"
                >{t("contactPage.phone", lang)}
                <span class="text-dark-300 normal-case tracking-normal"
                  >{t("contactPage.phoneOptional", lang)}</span
                ></span
              >
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              autocomplete="tel"
              class="input w-full"
            />
          </div>

          <div>
            <label for="subject" class="label">
              <span class="label-text"
                >{t("contactPage.subject", lang)}
                <span class="text-dark-300 normal-case tracking-normal"
                  >{t("contactPage.phoneOptional", lang)}</span
                ></span
              >
            </label>
            <select
              id="subject"
              name="subject"
              class="select w-full text-info"
            >
              <option value="">{t("contactPage.selectTopic", lang)}</option>
              <option value="buying"
                >{t("contactPage.topicBuying", lang)}</option
              >
              <option value="investing"
                >{t("contactPage.topicInvesting", lang)}</option
              >
              <option value="partnership"
                >{t("contactPage.topicPartnership", lang)}</option
              >
              <option value="general"
                >{t("contactPage.topicGeneral", lang)}</option
              >
            </select>
          </div>
          </div>

          <div>
            <label for="message" class="label">
              <span class="label-text">{t("contactPage.message", lang)}</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="3"
              required
              class="textarea w-full resize-none"
            ></textarea>
          </div>

          <div class="pt-2" slot="actions">
            <button type="submit" class="btn btn-primary">
              {t("contactPage.submit", lang)}
            </button>
          </div>
        </NetlifyForm>
        </div>

        {/* The direct contacts, then the social links. From 1024px this
            column is as tall as the form beside it and the social links sit
            at its foot, level with the form's button, so both columns end
            together. */}
        <div
          class="lg:col-span-5 lg:col-start-1 lg:row-start-2 flex flex-col"
        >
          <ContactDetails lang={lang} />
          <div class="flex gap-4 mt-8 lg:mt-auto lg:pt-4 lg:pb-2.5">
            <a
              href="https://www.linkedin.com/company/dottacunha"
              target="_blank"
              rel="noopener noreferrer"
              class="text-body-xs hover:text-base-content transition-colors uppercase tracking-wider"
              >LinkedIn</a
            >
            <a
              href="https://instagram.com/dottacunha"
              target="_blank"
              rel="noopener noreferrer"
              class="text-body-xs hover:text-base-content transition-colors uppercase tracking-wider"
              >Instagram</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
