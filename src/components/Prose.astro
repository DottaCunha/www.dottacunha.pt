---
interface Props {
  /** When set, the page title is rendered as a header above the body. */
  title?: string;
}

const { title } = Astro.props;
---

{
  title && (
    <section class="bg-base-100">
      <div class="container max-w-3xl pt-32 md:pt-40 pb-10 md:pb-12">
        <h1 class="section-heading text-4xl md:text-5xl text-base-content">
          {title}
        </h1>
      </div>
    </section>
  )
}

<section class="bg-base-100 pb-24 md:pb-32">
  <div class="container max-w-3xl">
    <article
      class:list={[
        "prose-content",
        title
          ? "border-t border-base-300 pt-10 md:pt-12"
          : "pt-10 md:pt-12",
      ]}
    >
      <slot />
    </article>
  </div>
</section>

<style>
  /* Styles target HTML produced by the rendered markdown body, so they must
     be :global() — Tailwind preflight strips heading/list defaults, hence the
     explicit declarations. Colours/fonts use the theme's CSS variables. */
  .prose-content > :global(:first-child) {
    margin-top: 0;
  }
  .prose-content :global(h2) {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-base-content);
    margin-top: 2.75rem;
    margin-bottom: 1rem;
  }
  .prose-content :global(h3) {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--color-base-content);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose-content :global(p) {
    font-size: 1rem;
    line-height: 1.75;
    font-weight: 300;
    color: var(--color-secondary);
    margin-bottom: 1.1rem;
  }
  .prose-content :global(ul),
  .prose-content :global(ol) {
    font-size: 1rem;
    line-height: 1.7;
    font-weight: 300;
    color: var(--color-secondary);
    margin-bottom: 1.1rem;
    padding-left: 1.35rem;
  }
  .prose-content :global(ul) {
    list-style-type: disc;
  }
  .prose-content :global(ol) {
    list-style-type: decimal;
  }
  .prose-content :global(li) {
    margin-bottom: 0.45rem;
    padding-left: 0.25rem;
  }
  .prose-content :global(strong) {
    font-weight: 500;
    color: var(--color-base-content);
  }
  .prose-content :global(a) {
    color: var(--color-base-content);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s ease;
  }
  .prose-content :global(a:hover) {
    color: var(--color-secondary);
  }
</style>
