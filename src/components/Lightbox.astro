---
import type { Lang } from "../i18n/translations";
import { t } from "../i18n/utils";

/**
 * One enlarged view for the whole page. Any button with `data-lightbox-src`
 * opens it; buttons that share a `data-lightbox-group` can be stepped through
 * with the arrows. An image larger than the screen (a floor plan on a phone)
 * can be tapped to see it at full size and dragged around.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<dialog class="lightbox" data-lightbox aria-label={t("lightbox.open", lang)}>
  <div class="lightbox-stage" data-lightbox-stage>
    <img data-lightbox-image alt="" />
  </div>
  <p class="lightbox-count" data-lightbox-count aria-live="polite"></p>
  <button
    type="button"
    class="lightbox-button lightbox-close"
    aria-label={t("lightbox.close", lang)}
    data-lightbox-close
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
      ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        d="M6 6l12 12M18 6L6 18"></path></svg
    >
  </button>
  <button
    type="button"
    class="lightbox-button lightbox-prev"
    aria-label={t("lightbox.previous", lang)}
    data-lightbox-prev
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
      ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        d="M15 19l-7-7 7-7"></path></svg
    >
  </button>
  <button
    type="button"
    class="lightbox-button lightbox-next"
    aria-label={t("lightbox.next", lang)}
    data-lightbox-next
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
      ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        d="M9 5l7 7-7 7"></path></svg
    >
  </button>
</dialog>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(10 10 10 / 0.96);
    color: white;
  }
  .lightbox::backdrop {
    background: rgb(10 10 10 / 0.96);
  }
  .lightbox-stage {
    position: absolute;
    inset: 3.5rem 0;
    display: flex;
    overflow: auto;
    overscroll-behavior: contain;
  }
  @media (min-width: 768px) {
    .lightbox-stage {
      inset: 3.5rem 4.5rem;
    }
  }
  /* The floor plans are drawings on a transparent background. */
  .lightbox-stage img {
    margin: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    background: white;
  }
  .lightbox-stage.can-zoom img {
    cursor: zoom-in;
  }
  .lightbox-stage.is-zoomed img {
    max-width: 260vw;
    max-height: none;
    cursor: zoom-out;
  }
  .lightbox-count {
    position: absolute;
    top: 0;
    left: 1.25rem;
    height: 3.5rem;
    display: flex;
    align-items: center;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    font-variant-numeric: tabular-nums;
    color: rgb(255 255 255 / 0.7);
  }
  .lightbox-button {
    position: absolute;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    transition: background-color 0.2s;
  }
  .lightbox-button:hover {
    background: rgb(255 255 255 / 0.12);
  }
  .lightbox-button[hidden] {
    display: none;
  }
  .lightbox-close {
    top: 0.375rem;
    right: 0.5rem;
  }
  .lightbox-prev,
  .lightbox-next {
    bottom: 0.375rem;
  }
  .lightbox-prev {
    right: 3.5rem;
  }
  .lightbox-next {
    right: 0.5rem;
  }
  @media (min-width: 768px) {
    .lightbox-prev,
    .lightbox-next {
      top: 50%;
      bottom: auto;
      transform: translateY(-50%);
    }
    .lightbox-prev {
      left: 0.875rem;
      right: auto;
    }
    .lightbox-next {
      right: 0.875rem;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  const stage = dialog?.querySelector<HTMLElement>("[data-lightbox-stage]");
  const image = dialog?.querySelector<HTMLImageElement>(
    "[data-lightbox-image]",
  );
  const count = dialog?.querySelector<HTMLElement>("[data-lightbox-count]");
  const previous = dialog?.querySelector<HTMLElement>("[data-lightbox-prev]");
  const next = dialog?.querySelector<HTMLElement>("[data-lightbox-next]");

  if (dialog && stage && image) {
    let items: HTMLElement[] = [];
    let index = 0;

    // Zooming only makes sense when the file has more detail than is shown.
    const updateZoom = () => {
      stage.classList.remove("is-zoomed");
      stage.classList.toggle(
        "can-zoom",
        image.naturalWidth > image.clientWidth * 1.15,
      );
    };

    const show = (to: number) => {
      index = (to + items.length) % items.length;
      const item = items[index];
      stage.classList.remove("is-zoomed", "can-zoom");
      image.src = item.dataset.lightboxSrc ?? "";
      image.alt = item.dataset.lightboxAlt ?? "";
      if (count) {
        count.textContent =
          items.length > 1 ? `${index + 1} / ${items.length}` : "";
      }
      previous?.toggleAttribute("hidden", items.length < 2);
      next?.toggleAttribute("hidden", items.length < 2);
    };

    image.addEventListener("load", updateZoom);
    window.addEventListener("resize", () => {
      if (dialog.open && !stage.classList.contains("is-zoomed")) updateZoom();
    });

    document.addEventListener("click", (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>(
        "[data-lightbox-src]",
      );
      if (!trigger) return;
      const group = trigger.dataset.lightboxGroup;
      items = group
        ? [
            ...document.querySelectorAll<HTMLElement>(
              `[data-lightbox-group="${group}"]`,
            ),
          ]
        : [trigger];
      show(items.indexOf(trigger));
      dialog.showModal();
      document.documentElement.style.overflow = "hidden";
      document.dispatchEvent(new CustomEvent("lightbox:open"));
    });

    dialog.addEventListener("close", () => {
      document.documentElement.style.overflow = "";
      image.removeAttribute("src");
    });

    dialog
      .querySelector("[data-lightbox-close]")
      ?.addEventListener("click", () => dialog.close());
    previous?.addEventListener("click", () => show(index - 1));
    next?.addEventListener("click", () => show(index + 1));

    // A click on the picture zooms; a click on the dark area around it closes.
    stage.addEventListener("click", (event) => {
      if (event.target !== image) {
        dialog.close();
        return;
      }
      if (stage.classList.contains("is-zoomed")) {
        stage.classList.remove("is-zoomed");
      } else if (stage.classList.contains("can-zoom")) {
        // Keep the point that was clicked under the finger.
        const box = image.getBoundingClientRect();
        const x = (event.clientX - box.left) / box.width;
        const y = (event.clientY - box.top) / box.height;
        stage.classList.add("is-zoomed");
        stage.scrollLeft = x * image.offsetWidth - stage.clientWidth / 2;
        stage.scrollTop = y * image.offsetHeight - stage.clientHeight / 2;
      }
    });

    dialog.addEventListener("keydown", (event) => {
      if (items.length < 2) return;
      if (event.key === "ArrowLeft") show(index - 1);
      if (event.key === "ArrowRight") show(index + 1);
    });
  }
</script>
