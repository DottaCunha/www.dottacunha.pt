---
interface Props {
  /** Eyebrow: a short label above the heading. */
  label?: string;
  heading: string;
  /** Subheading: one short sentence under the heading. */
  body?: string;
}

const { label, heading, body } = Astro.props;
---

<div class="max-w-2xl mb-12 md:mb-16">
  {label && <span class="section-label mb-3">{label}</span>}
  <h2 class="section-heading">{heading}</h2>
  {body && <p class="text-body text-dark-600 mt-5">{body}</p>}
</div>
