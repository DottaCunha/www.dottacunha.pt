---
interface Props {
  name: string;
  class?: string;
  successMessage?: string;
}

const {
  name,
  class: className = "",
  successMessage = "Thank you! We'll be in touch soon.",
} = Astro.props;
---

<div class="netlify-form-wrapper" data-success-message={successMessage}>
  <form
    name={name}
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    class={className}
  >
    <!-- Netlify hidden fields -->
    <input type="hidden" name="form-name" value={name} />
    <p class="hidden" aria-hidden="true">
      <label>Don't fill this out: <input name="bot-field" /></label>
    </p>

    <!-- Form fields via slot -->
    <slot />
  </form>

  <!-- Error state (hidden by default) -->
  <p class="form-error hidden text-sm mt-4" role="alert"></p>

  <!-- Success state (hidden by default) -->
  <div class="form-success hidden" role="alert">
    <div
      class="flex flex-col items-center justify-center text-center py-12 gap-4"
    >
      <svg
        class="w-12 h-12 opacity-60"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <p class="text-body font-medium">{successMessage}</p>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll(".netlify-form-wrapper").forEach((wrapper) => {
    const form = wrapper.querySelector("form");
    const success = wrapper.querySelector(".form-success");
    const error = wrapper.querySelector(".form-error");
    if (!form || !success) return;

    const errorText =
      document.documentElement.lang === "pt"
        ? "Não foi possível enviar a mensagem. Tente novamente ou escreva para hello@dottacunha.pt."
        : "We couldn't send your message. Please try again or email hello@dottacunha.pt.";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
      }
      error?.classList.add("hidden");

      try {
        // POST to this page's own path, which is a prerendered (static) file.
        // "/" is an on-demand route, so Netlify Forms never sees a POST sent
        // there: the request is answered by the language redirect instead.
        const response = await fetch(window.location.pathname, {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(new FormData(form) as any).toString(),
        });

        // A redirected response means the POST was not handled by Netlify Forms.
        if (response.ok && !response.redirected) {
          form.classList.add("hidden");
          success.classList.remove("hidden");
        } else {
          throw new Error("Form submission failed");
        }
      } catch {
        if (submitBtn) {
          submitBtn.disabled = false;
        }
        if (error) {
          error.textContent = errorText;
          error.classList.remove("hidden");
        }
      }
    });
  });
</script>
