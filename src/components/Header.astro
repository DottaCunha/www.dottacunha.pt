---
import type { Lang } from "../i18n/translations";
import { languages } from "../i18n/translations";
import { t, localizedPath, getAlternateLang } from "../i18n/utils";
import Logo from "./Logo.astro";

interface Props {
  darkHeader?: boolean;
  lang: Lang;
}

const { darkHeader = false, lang } = Astro.props;
const currentPath = Astro.url.pathname;
const altLang = getAlternateLang(lang);

// Strip the lang prefix to get the base path
const basePath = currentPath.replace(/^\/(en|pt)/, "") || "/";

const navLinks = [
  {
    href: localizedPath("/", lang),
    label: t("nav.home", lang),
    match: `/${lang}`,
  },
  {
    href: localizedPath("/about", lang),
    label: t("nav.about", lang),
    match: `/${lang}/about`,
  },
  {
    href: localizedPath("/projects", lang),
    label: t("nav.projects", lang),
    match: `/${lang}/projects`,
  },
  {
    href: localizedPath("/services", lang),
    label: t("nav.services", lang),
    match: `/${lang}/services`,
  },
  {
    href: localizedPath("/contact", lang),
    label: t("nav.contact", lang),
    match: `/${lang}/contact`,
  },
];

const isActive = (match: string) => {
  const clean = currentPath.replace(/\/$/, "");
  const cleanMatch = match.replace(/\/$/, "");
  return clean === cleanMatch;
};
---

{/* The colour of the browser's own bars on recent iPhones (the strip around
    the island). Safari 26 ignores the theme-color tag: it looks at the middle
    of the top edge of the screen, takes whatever fixed element is on top
    there, and copies its background colour if that colour is solid. With a
    see-through element (this site's header at the top of a page) it samples
    pixels instead and keeps the sample, which is how the bar got stuck on
    the wrong colour. So this strip sits on top at that spot, always in a
    solid colour. It is 12px tall, the least Safari will read, with 5px on
    screen and the rest above the edge; a short fade hides its lower edge.
    The script below swaps in a fresh copy whenever the colour changes,
    because Safari reads a new element more reliably than a change to one it
    has already seen. It only exists in Safari on phones (see the styles):
    other browsers have no such bar to colour and would just show the strip.
    It must stay outside the header, whose backdrop blur would hide it from
    Safari. */}
<div
  id="browser-bar-tint"
  class="browser-bar-tint"
  style={`--tint: ${darkHeader ? "#0a0a0a" : "#ffffff"}`}
  aria-hidden="true"
>
</div>
<header
  id="site-header"
  class="navbar fixed top-0 left-0 right-0 z-50 transition-all duration-500"
  data-dark={darkHeader ? "true" : "false"}
>
  <div class="container flex items-center justify-between h-20">
    <!-- Logo (navbar-start) -->
    <div class="navbar-start">
      <a
        href={localizedPath("/", lang)}
        class="flex items-center relative z-10 header-logo transition-colors duration-500"
        aria-label="Dotta & Cunha"
      >
        <Logo size="md" />
      </a>
    </div>

    <!-- Desktop Nav & CTA (navbar-end) -->
    <div class="navbar-end hidden md:flex items-center gap-8">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "text-xs font-medium uppercase tracking-[0.15em] transition-all duration-300 header-link",
              isActive(link.match) ? "is-active" : "",
            ]}
          >
            {link.label}
          </a>
        ))
      }

      <a
        href={localizedPath("/contact", lang)}
        class="btn btn-outline btn-sm text-xxs tracking-[0.15em] header-cta"
      >
        {t("nav.cta", lang)}
      </a>
      <!-- Language Switcher -->
      <a
        href={`/${altLang}${basePath === "/" ? "" : basePath}`}
        class="text-xxs font-medium uppercase tracking-[0.15em] transition-all duration-300 header-link p-2 -m-2"
        title={languages[altLang]}
      >
        {altLang.toUpperCase()}
      </a>
    </div>

    <!-- Mobile Toggle -->
    <button
      id="mobile-toggle"
      class="md:hidden p-2 relative z-10"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <div class="hamburger">
        <span class="hamburger-bar header-bar" id="bar-1"></span>
        <span class="hamburger-bar header-bar" id="bar-2"></span>
      </div>
    </button>
  </div>
</header>

<!-- Mobile Menu (outside header: backdrop-filter on header would trap it
     inside the bar). It is laid out as part of the page, not fixed to the
     screen: on recent iPhones a fixed layer reaching the bottom edge makes
     Safari paint its see-through address bar in a solid colour and keep it
     that way after the menu closes. As page content the menu simply shows
     through the bar, like the rest of the page. The script places it at the
     current scroll position when it opens; it is taller than the screen so
     that it also fills the area behind the address bar. -->
<div
  id="mobile-menu"
  class="md:hidden absolute inset-x-0 top-0 h-[calc(100lvh+5rem)] bg-primary z-40 -translate-y-full"
  aria-hidden="true"
>
  <nav class="flex flex-col items-center justify-center h-svh gap-8">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "font-display text-2xl font-bold uppercase tracking-wider text-white/60 hover:text-white transition-colors",
            isActive(link.match) ? "!text-white" : "",
          ]}
        >
          {link.label}
        </a>
      ))
    }
    <!-- Mobile language switch -->
    <a
      href={`/${altLang}${basePath === "/" ? "" : basePath}`}
      class="text-sm font-medium uppercase tracking-wider text-white/40 hover:text-white transition-colors border-t border-white/10 pt-6 mt-2"
    >
      {languages[altLang]}
    </a>
    <a
      href={localizedPath("/contact", lang)}
      class="btn btn-outline mt-2 btn-light"
    >
      {t("nav.cta", lang)}
    </a>
  </nav>
</div>

<style is:global>
  .browser-bar-tint {
    display: none;
    position: fixed;
    top: -7px;
    left: 0;
    right: 0;
    height: 12px;
    z-index: 60;
    pointer-events: none;
    background-color: var(--tint);
  }
  .browser-bar-tint::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 28px;
    background: linear-gradient(var(--tint), transparent);
    opacity: 0.5;
  }
  /* -webkit-touch-callout only exists in Safari on iPhone and iPad. */
  @supports (-webkit-touch-callout: none) {
    @media (max-width: 767px) {
      .browser-bar-tint {
        display: block;
      }
    }
  }
</style>

<style>
  /* Default state: transparent, dark text (for light pages) */
  header {
    background: transparent;
  }
  header .header-logo {
    color: var(--color-base-content);
  }
  header .header-link {
    color: var(--color-secondary);
  }
  header .header-link:hover,
  header .header-link.is-active {
    color: var(--color-base-content);
  }
  header .header-cta {
    border: 1px solid var(--color-base-content);
    color: var(--color-base-content);
  }
  header .header-cta:hover {
    background: var(--color-base-content);
    color: var(--color-base-100);
  }
  header .header-bar {
    background: var(--color-base-content);
  }

  /* Dark variant (hero pages): white text when at top */
  header[data-dark="true"] .header-logo {
    color: white;
  }
  header[data-dark="true"] .header-link {
    color: white;
  }
  header[data-dark="true"] .header-link:hover {
    color: rgba(255, 255, 255, 0.6);
  }
  header[data-dark="true"] .header-cta {
    border-color: rgba(255, 255, 255, 0.3);
    color: white;
  }
  header[data-dark="true"] .header-cta:hover {
    background: var(--color-base-100);
    color: var(--color-base-content);
  }
  header[data-dark="true"] .header-bar {
    background: white;
  }

  /* Scrolled state: frosted glass with dark text */
  header.is-scrolled {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(20px);
  }
  header.is-scrolled .header-logo {
    color: var(--color-base-content) !important;
  }
  header.is-scrolled .header-link {
    color: var(--color-secondary) !important;
  }
  header.is-scrolled .header-link:hover,
  header.is-scrolled .header-link.is-active {
    color: var(--color-base-content) !important;
  }
  header.is-scrolled .header-cta {
    border-color: var(--color-base-content) !important;
    color: var(--color-base-content) !important;
  }
  header.is-scrolled .header-cta:hover {
    background: var(--color-base-content) !important;
    color: var(--color-base-100) !important;
  }
  header.is-scrolled .header-bar {
    background: var(--color-base-content) !important;
  }

  /* Hamburger -> X animation */
  .hamburger {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 24px;
  }
  .hamburger-bar {
    display: block;
    width: 100%;
    height: 1px;
    transform-origin: center;
    transition:
      transform 0.3s ease,
      background-color 0.3s ease;
  }
  #mobile-toggle.is-open #bar-1 {
    transform: translateY(3.5px) rotate(45deg);
  }
  #mobile-toggle.is-open #bar-2 {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* When menu is open, force bars + logo white (menu has dark primary bg) and keep header transparent */
  /* Closed, the menu is parked above where it last opened, which can be
     inside the page: it is hidden once it has slid away so that it cannot
     be scrolled to (or reached with the keyboard). */
  /* "translate", not "transform": that is the property the Tailwind
     translate classes on the menu set. */
  #mobile-menu {
    transition:
      translate 500ms ease-in-out,
      visibility 0s;
  }
  #mobile-menu[aria-hidden="true"] {
    visibility: hidden;
    transition:
      translate 500ms ease-in-out,
      visibility 0s 500ms;
  }

  /* The menu slides down from the top edge, so the bar's white has to be
     gone by the time the menu's leading edge passes it: at the normal
     500ms the bar was still fading with half the screen already dark. */
  header.menu-open {
    background: transparent !important;
    backdrop-filter: none !important;
    transition-duration: 150ms;
  }
  header.menu-open .header-bar {
    background: white !important;
  }
  header.menu-open .header-logo {
    color: white !important;
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("mobile-toggle");
  const menu = document.getElementById("mobile-menu");

  const themeColor = document.querySelector<HTMLMetaElement>(
    'meta[name="theme-color"]',
  );
  let barTints = [...document.querySelectorAll<HTMLElement>(".browser-bar-tint")];
  let barColour = barTints[0]?.style.getPropertyValue("--tint").trim();

  function updateHeader() {
    if (!header) return;
    const scrolled = window.scrollY > 50;
    header.classList.toggle("is-scrolled", scrolled);
    syncBrowserBars();
  }

  // The browser's own bars (the strip around the iPhone's island) follow the
  // header: dark over the photo at the top of the page or under the open
  // menu, white once the header turns white. Browsers that honour the
  // theme-color tag read it from there; recent iPhones read it from the
  // strip at the top of the page (see the markup above). The page
  // background, which those iPhones fall back to, is set once in the layout
  // and left alone: changing it at run time was followed late or not at all.
  function syncBrowserBars() {
    if (!header) return;
    const dark =
      header.classList.contains("menu-open") ||
      document.querySelector("dialog[open]") !== null ||
      (header.dataset.dark === "true" &&
        !header.classList.contains("is-scrolled"));
    const colour = dark ? "#0a0a0a" : "#ffffff";
    if (themeColor) themeColor.content = colour;
    if (barTints.length > 0 && colour !== barColour) {
      barTints = barTints.map((strip) => {
        const fresh = strip.cloneNode() as HTMLElement;
        fresh.style.setProperty("--tint", colour);
        strip.replaceWith(fresh);
        return fresh;
      });
      barColour = colour;
    }
  }

  window.addEventListener("scroll", updateHeader, { passive: true });
  updateHeader();

  // The enlarged photo view is dark: the bars go dark while it is open and
  // back to the header's colour when it closes.
  document.addEventListener("lightbox:open", syncBrowserBars);
  document.addEventListener("lightbox:close", syncBrowserBars);

  const pageIsDark = document.body.classList.contains("bg-primary");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.classList.toggle("is-open");
    if (isOpen && menu) menu.style.top = `${window.scrollY}px`;
    // On an iPhone, at the very top of a page, Safari fades the page's
    // background colour in behind its address bar. On a white page that put
    // a white haze over the dark menu, so the page background goes dark
    // while the menu is open. (Pages that open with a photo already have a
    // dark background, set in the layout, and are left alone.) Nothing else
    // changes on screen: the page's content covers this background.
    if (!pageIsDark) document.body.classList.toggle("bg-primary", isOpen);
    menu?.classList.toggle("-translate-y-full", !isOpen);
    menu?.classList.toggle("translate-y-0", isOpen);
    header?.classList.toggle("menu-open", isOpen);
    syncBrowserBars();
    toggle.setAttribute("aria-expanded", String(isOpen));
    menu?.setAttribute("aria-hidden", String(!isOpen));
    document.body.style.overflow = isOpen ? "hidden" : "";
  });
</script>
