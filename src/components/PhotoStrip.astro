---
import type { Lang } from "../i18n/translations";
import { t } from "../i18n/utils";
import PublicPicture from "./PublicPicture.astro";

interface Props {
  lang: Lang;
  photos: string[];
  /** The home the photos belong to: "Apartamento C, Carrascal 168". */
  alt: string;
  /** What each photo shows ("Sala e cozinha"), in the order of the photos. */
  captions?: string[];
}

const { lang, photos, alt, captions = [] } = Astro.props;
// "Sala e cozinha, Apartamento C, Carrascal 168"; a photo without a caption
// falls back to its number.
const altOf = (i: number) =>
  captions[i] ? `${captions[i]}, ${alt}` : `${alt} (${i + 1})`;
---

{/* From tablets up every photo has the same height and its own width. On
    phones every photo has the same frame instead (upright, 3:4, the shape of
    most of the photos): a photo of another shape fills the frame and is
    trimmed at the sides, so the row has one height. The enlarged view shows
    it whole. */}
<div class="relative" data-photo-strip>
  <div
    class="photo-strip-track flex items-start gap-3 overflow-x-auto snap-x snap-mandatory scroll-smooth"
    data-photo-track
  >
    {
      photos.map((photo, i) => (
        <button
          type="button"
          class="snap-start shrink-0 bg-base-300 cursor-zoom-in w-[82vw] max-sm:aspect-[3/4] sm:w-auto sm:h-[60vh] sm:min-h-[320px] sm:max-h-[640px]"
          aria-label={`${t("lightbox.open", lang)}: ${altOf(i)}`}
          data-lightbox-src={photo}
          data-lightbox-group="photos"
          data-lightbox-alt={altOf(i)}
        >
          <PublicPicture
            src={photo}
            alt={altOf(i)}
            formats={["avif", "webp"]}
            widths={[400, 800, 1200, 1600]}
            sizes="(max-width: 768px) 85vw, 640px"
            loading={i < 2 ? "eager" : "lazy"}
            pictureAttributes={{ class: "block h-full" }}
            class="w-full h-full max-sm:object-cover sm:w-auto sm:max-w-none"
          />
        </button>
      ))
    }
  </div>

  {
    photos.length > 1 && (
      <div class="flex justify-end gap-2 mt-4">
        <button
          type="button"
          class="w-10 h-10 border border-base-content/25 hover:bg-base-100 flex items-center justify-center transition-colors"
          aria-label={t("carousel.previous", lang)}
          data-photo-prev
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M15 19l-7-7 7-7"
            />
          </svg>
        </button>
        <button
          type="button"
          class="w-10 h-10 border border-base-content/25 hover:bg-base-100 flex items-center justify-center transition-colors"
          aria-label={t("carousel.next", lang)}
          data-photo-next
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M9 5l7 7-7 7"
            />
          </svg>
        </button>
      </div>
    )
  }
</div>

<style>
  .photo-strip-track {
    scrollbar-width: none;
  }
  .photo-strip-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // The strip moves on by itself, one photo at a time, until the visitor
  // takes over. It waits while it is off screen, under the pointer or behind
  // the enlarged view, and never starts for people who asked for less motion.
  const INTERVAL = 4000;
  const stillMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  document
    .querySelectorAll<HTMLElement>("[data-photo-strip]")
    .forEach((strip) => {
      const track = strip.querySelector<HTMLElement>("[data-photo-track]");
      if (!track) return;

      const atEnd = () =>
        track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      const step = (direction: number) =>
        track.scrollBy({ left: direction * track.clientWidth * 0.8 });
      const advance = () => {
        if (atEnd()) {
          track.scrollTo({ left: 0 });
          return;
        }
        const items = [...track.children] as HTMLElement[];
        const origin = track.getBoundingClientRect().left;
        const upcoming = items.find(
          (item) => item.getBoundingClientRect().left - origin > 4,
        );
        if (upcoming) {
          track.scrollBy({
            left: upcoming.getBoundingClientRect().left - origin,
          });
        }
      };

      let stopped = stillMotion.matches || track.children.length < 2;
      let visible = false;
      let hovered = false;
      let timer: number | undefined;

      const update = () => {
        const run =
          !stopped &&
          visible &&
          !hovered &&
          !document.hidden &&
          !document.querySelector("dialog[open]");
        if (run && timer === undefined) {
          timer = window.setInterval(advance, INTERVAL);
        } else if (!run && timer !== undefined) {
          window.clearInterval(timer);
          timer = undefined;
        }
      };
      const stop = () => {
        stopped = true;
        update();
      };

      strip.querySelector("[data-photo-prev]")?.addEventListener("click", () => {
        stop();
        step(-1);
      });
      strip.querySelector("[data-photo-next]")?.addEventListener("click", () => {
        stop();
        step(1);
      });
      // "focusin" covers people who reach the photos with the keyboard.
      for (const type of [
        "pointerdown",
        "touchstart",
        "wheel",
        "keydown",
        "focusin",
      ]) {
        strip.addEventListener(type, stop, { passive: true });
      }
      strip.addEventListener("pointerenter", () => {
        hovered = true;
        update();
      });
      strip.addEventListener("pointerleave", () => {
        hovered = false;
        update();
      });
      document.addEventListener("visibilitychange", update);
      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          update();
        },
        { threshold: 0.5 },
      ).observe(track);
    });
</script>
