---
import { opticalStart } from "../../lib/optical";
import { localizedPath } from "../../i18n/utils";
import type { Lang } from "../../i18n/translations";
import type { BlockProps } from "../../lib/blocks";
import PublicPicture from "../PublicPicture.astro";

export type Props = BlockProps<"hero">;

const { lang } = Astro.params as { lang: Lang };

const props = Astro.props;
---

{
  props.variant === "full" && (
    <section class="section hero-behind-bar max-md:pb-[calc(100lvh-100svh+11rem)] md:min-h-screen relative flex items-center bg-neutral text-neutral-content overflow-hidden">
      {/* On phones the photo runs on below the visible screen, so that it also
          fills the area behind the iPhone's see-through address bar (same as
          the project hero); the extra bottom padding keeps the text centred
          in the part of the screen that is actually visible. */}
      <div class="absolute inset-0">
        {props.image && (
          <PublicPicture
            priority
            quality={60}
            sizes="100vw"
            src={props.image}
            formats={["avif", "webp"]}
            widths={[400, 800, 1200, 1600, 2000]}
            alt=""
            class="w-full h-full object-cover opacity-50"
          />
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/30 to-primary/50" />
      </div>

      <div class="container relative z-10">
        <div class="max-w-4xl">
          {props.label && <p class="section-label mb-4" style={opticalStart(props.label, "sans")}>{props.label}</p>}
          {props.heading && (
            <h1
              class="heading-hero text-5xl md:text-7xl lg:text-display-lg mb-8"
              style={opticalStart(props.heading, "display")}
            >
              {props.heading}
            </h1>
          )}
          {props.body && (
            <p class="text-lg leading-relaxed mb-12 max-w-xl font-light">
              {props.body}
            </p>
          )}
          {(props.cta_primary || props.cta_secondary) && (
            <div class="flex items-center gap-6">
              {props.cta_primary && (
                <a
                  class="btn"
                  href={localizedPath(props.cta_primary.href, lang)}
                >
                  {props.cta_primary.label}
                </a>
              )}
              {props.cta_secondary && (
                <a
                  class="btn btn-outline"
                  href={localizedPath(props.cta_secondary.href, lang)}
                >
                  {props.cta_secondary.label}
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </section>
  )
}
{
  props.variant === "half" && (
    <section class="section relative min-h-[45vh] flex items-end overflow-hidden bg-primary text-primary-content">
      <div class="absolute inset-0">
        {props.image && (
          <PublicPicture
            priority
            quality={60}
            sizes="100vw"
            src={props.image}
            formats={["avif", "webp"]}
            widths={[400, 800, 1200, 1600, 2000]}
            alt=""
            class="w-full h-full object-cover opacity-50"
          />
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/40 to-primary/60" />
      </div>
      <div class="container relative z-10">
        {props.label && <span class="section-label mb-4" style={opticalStart(props.label, "sans")}>{props.label}</span>}
        {props.heading && (
          <h1
            class="heading-hero text-5xl md:text-7xl lg:text-display"
            style={opticalStart(props.heading, "display")}
          >
            {props.heading}
          </h1>
        )}
      </div>
    </section>
  )
}
