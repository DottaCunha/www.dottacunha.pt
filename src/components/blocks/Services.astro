---
import type { BlockProps } from "../../lib/blocks";
import PublicPicture from "../PublicPicture.astro";

export type Props = BlockProps<"services">;

const { items = [] } = Astro.props;

const toParagraphs = (text?: string) =>
  text
    ?.split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean) ?? [];

// Service images may be a local public/ path (optimized by PublicPicture)
// or a remote URL (rendered as a plain <img>, loaded straight from the CDN).
const isRemote = (src?: string): src is string =>
  !!src && /^https?:\/\//.test(src);
---

<section class="section bg-base-100 text-base-content">
  <div class="container">
    {
      items.map((service, i) => (
        <article
          id={service.key}
          class:list={[
            "scroll-mt-28 grid grid-cols-1 items-stretch gap-8 lg:grid-cols-12 lg:gap-16",
            i === 0 ? "" : "mt-24 md:mt-32",
            i % 2 !== 0 ? "lg:[direction:rtl]" : "",
          ]}
        >
          <div class="lg:col-span-5">
            <div class="aspect-[4/3] lg:aspect-auto lg:h-full lg:min-h-[420px] overflow-hidden bg-base-300">
              {service.image &&
                (isRemote(service.image) ? (
                  <img
                    src={service.image}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                ) : (
                  <PublicPicture
                    src={service.image}
                    alt=""
                    formats={["avif", "webp"]}
                    widths={[400, 800, 1200, 1600]}
                    sizes="(max-width: 1024px) 100vw, 500px"
                    loading="lazy"
                    class="h-full w-full object-cover"
                  />
                ))}
            </div>
          </div>
          <div
            class:list={[
              "flex flex-col justify-center lg:col-span-7",
              i % 2 !== 0 ? "lg:[direction:ltr]" : "",
            ]}
          >
            <span class="text-index block">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="heading-card mb-4 mt-3">{service.heading}</h3>
            {toParagraphs(service.body).map((p) => (
              <p class="text-body text-secondary mb-4">{p}</p>
            ))}
            {service.features && service.features.length > 0 && (
              <ul class="mt-8 space-y-3">
                {service.features.map((feature) => (
                  <li class="flex items-start gap-4 text-md text-secondary">
                    <span
                      class="mt-[0.65em] h-px w-5 shrink-0 bg-base-content/30"
                      aria-hidden="true"
                    />
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
