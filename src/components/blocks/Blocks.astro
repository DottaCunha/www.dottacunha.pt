---
import type { PageBlock } from "../../lib/blocks";
import CTA from "./CTA.astro";
import Hero from "./Hero.astro";
import Images from "./Images.astro";
import List from "./List.astro";
import Process from "./Process.astro";
import Projects from "./Projects.astro";
import Section from "./Section.astro";
import Services from "./Services.astro";

type Props = { blocks?: PageBlock[] };

const props = Astro.props;
---

<>
  {
    props.blocks?.map((block) => {
      if (block.type === "hero") {
        return <Hero {...block} />;
      }
      if (block.type === "section") {
        return <Section {...block} />;
      }
      if (block.type === "cta") {
        return <CTA {...block} />;
      }
      if (block.type === "images") {
        return <Images {...block} />;
      }
      if (block.type === "list") {
        return <List {...block} />;
      }
      if (block.type === "projects") {
        return <Projects {...block} />;
      }
      if (block.type === "services") {
        return <Services {...block} />;
      }
      if (block.type === "process") {
        return <Process {...block} />;
      }
    })
  }
</>
