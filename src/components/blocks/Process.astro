---
import type { BlockProps } from "../../lib/blocks";

export type Props = BlockProps<"process">;

const { label, heading, items } = Astro.props;
---

<section class="section bg-base-200">
  <div class="container">
    <div class="mb-20">
      {label && <span class="section-label">{label}</span>}
      {heading && <h2 class="section-heading">{heading}</h2>}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      {
        items?.map((item) => (
          <div>
            <div class="font-display text-6xl font-extrabold text-dark-100 tracking-tight mb-4">
              {item.step}
            </div>
            <h3 class="heading-card-sm text-base-content mb-3">
              {item.heading}
            </h3>
            <p class="text-body-xs leading-relaxed">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
